{
  "name": "trading-journal-pro",
  "version": "1.0.0",
  "description": "Trading Journal Pro - Startup Grade Web Platform for Forex & Gold Traders",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "backend": "php.bat -S 127.0.0.1:8000 -t backend/public backend/public/index.php",
    "migrate": "php.bat backend/artisan migrate",
    "seed": "php.bat backend/artisan db:seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3"
  }
}
